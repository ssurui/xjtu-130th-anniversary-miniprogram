/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #8B0000 0%, #c0392b 30%, #f5f0e8 30%);
  padding-bottom: 60rpx;
}

/* 校庆Banner */
.banner-section {
  position: relative;
  padding: 30rpx 30rpx 0;
  text-align: center;
}

.banner-image {
  width: 100%;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.3);
}

.anniversary-text {
  position: absolute;
  top: 60rpx;
  right: 60rpx;
  text-align: center;
}

.year-text {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.5);
  line-height: 1;
}

.anniversary-label {
  display: block;
  font-size: 24rpx;
  color: #FFD700;
  letter-spacing: 4rpx;
}

/* VIP卡 */
.vip-card-section {
  padding: 30rpx 30rpx 0;
}

.vip-card {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.3);
  position: relative;
  overflow: hidden;
}

.vip-card::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.2), transparent);
  border-radius: 50%;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.card-logo {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.card-title {
  font-size: 28rpx;
  color: #FFD700;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.card-body {
  border-top: 1rpx solid rgba(255, 215, 0, 0.3);
  padding-top: 30rpx;
}

.card-number-row,
.coupon-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.card-number {
  font-size: 32rpx;
  color: #fff;
  font-family: 'Courier New', monospace;
  letter-spacing: 4rpx;
}

.coupon-amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFD700;
}

.card-footer {
  border-top: 1rpx solid rgba(255, 215, 0, 0.3);
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.card-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 礼品区域 */
.gift-section {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #8B0000;
  display: block;
  margin-bottom: 20rpx;
}

.gift-content {
  display: flex;
  align-items: center;
}

.gift-image {
  width: 160rpx;
  height: 160rpx;
  margin-right: 30rpx;
  border-radius: 16rpx;
  background: #f5f0e8;
}

.gift-info {
  flex: 1;
}

.gift-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.gift-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* 抽奖区域 */
.lottery-section {
  margin: 20rpx 30rpx;
  text-align: center;
}

.lottery-banner {
  background: linear-gradient(135deg, #8B0000, #c0392b);
  border-radius: 20rpx 20rpx 0 0;
  padding: 30rpx;
  margin-bottom: -10rpx;
}

.lottery-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #FFD700;
  margin-bottom: 10rpx;
}

.lottery-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.lottery-btn {
  width: 100%;
  border-radius: 0 0 20rpx 20rpx;
  padding: 30rpx;
  font-size: 34rpx;
  font-weight: bold;
  margin: 0;
}

.btn-primary {
  background: linear-gradient(135deg, #FFD700, #FFA500);
  color: #8B0000;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(255, 165, 0, 0.5);
}

.btn-disabled {
  background: #ccc;
  color: #888;
  border: none;
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #FFD700;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
