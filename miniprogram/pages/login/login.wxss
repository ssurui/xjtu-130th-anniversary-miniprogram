/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #8B0000 0%, #c0392b 40%, #f5f0e8 40%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
}

/* 顶部 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  width: 100%;
}

.logo {
  width: 80%;
  margin: 0 auto 20rpx;
  display: block;
  border-radius: 16rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 215, 0, 0.8);
  letter-spacing: 4rpx;
}

/* 登录卡片 */
.login-card {
  background: #fff;
  border-radius: 30rpx;
  padding: 50rpx 40rpx;
  width: 100%;
  box-shadow: 0 10rpx 50rpx rgba(0, 0, 0, 0.15);
  text-align: center;
}

.login-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B0000;
  display: block;
  margin-bottom: 40rpx;
}

/* 权益列表 */
.benefits {
  margin-bottom: 50rpx;
  text-align: left;
}

.benefit-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #f9f4ec;
  border-radius: 16rpx;
}

.benefit-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.benefit-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

/* 按钮 */
.phone-btn {
  width: 100%;
  background: linear-gradient(135deg, #8B0000, #c0392b);
  color: #FFD700;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 60rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(139, 0, 0, 0.4);
  border: none;
}

.skip-btn {
  width: 100%;
  background: transparent;
  color: #8B0000;
  font-size: 30rpx;
  border-radius: 60rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid #8B0000;
}

.privacy-tip {
  font-size: 22rpx;
  color: #aaa;
  display: block;
  line-height: 1.6;
}
